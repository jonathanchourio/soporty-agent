{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Soporty Agente",
  "version": "1.0.0",
  "identifier": "com.soporty.agent",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Soporty Agente",
        "width": 460,
        "height": 640,
        "minWidth": 380,
        "minHeight": 520,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "languages": ["Spanish", "SpanishInternational", "English"]
      }
    }
  }
}
